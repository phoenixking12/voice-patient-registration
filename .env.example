# Copy to .env. Leave a line blank if you do not have that account yet.
# The app runs, saves patients, and talks on the browser desk with every line blank.

# Optional. Free key from https://console.groq.com
# Used only to rephrase the local desk. The phone agent can use Vapi's own model instead.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional. Paid. Used only if GROQ_API_KEY is empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Public https address Vapi will call. ngrok or Railway. No trailing path.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# sqlite file by default. Survives restarts. Example Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/harbor
DATABASE_URL=sqlite:///./harbor.db

# true on first local run so the registry is not empty. Tests turn this off.
SEED=true
